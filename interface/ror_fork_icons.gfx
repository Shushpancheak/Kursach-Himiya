# Sprite declarations for artwork that shipped without one.
#
# Each texture below already existed in gfx/ but no spriteType referenced
# it, so the idea or focus rendered with a missing icon. Declaring them
# is additive: no upstream file is touched.
#
# See docs/known-upstream-defects.md, N-05 and N-06. Values that still
# have no artwork at all are listed there and are deliberately absent
# here — a spriteType pointing at a file that does not exist would trade
# a missing icon for a load error.

spriteTypes = {

	# --- focus icons -------------------------------------------------------
	spriteType = {
		name = "GFX_BLR_otkr_gos_univer"
		texturefile = "gfx/interface/goals/LitBlr/BLR_otkr_gos_univer.dds"
	}
	spriteType = {
		name = "GFX_BLR_razvit_obrz"
		texturefile = "gfx/interface/goals/LitBlr/BLR_razvit_obrz.dds"
	}
	spriteType = {
		name = "GFX_BLR_sovmest_zased"
		texturefile = "gfx/interface/goals/LitBlr/BLR_sovmest_zased.dds"
	}

	# --- idea icons --------------------------------------------------------
	# Names starting with GFX_ rather than GFX_idea_ are intentional: the
	# ideas reference them that way, and the engine falls back to using the
	# picture value verbatim as a sprite name.
	spriteType = {
		name = "GFX_CPG_army_poor_army"
		texturefile = "gfx/interface/ideas/CPG/CPG_army_poor_army.dds"
	}
	spriteType = {
		name = "GFX_CPG_brit_zakon"
		texturefile = "gfx/interface/ideas/CPG/CPG_brit_zakon.dds"
	}
	spriteType = {
		name = "GFX_CPG_econom_sotr_cpg"
		texturefile = "gfx/interface/ideas/CPG/CPG_econom_sotr_cpg.dds"
	}
	spriteType = {
		name = "GFX_CPG_eng_dobrovolci"
		texturefile = "gfx/interface/ideas/CPG/CPG_eng_dobrovolci.dds"
	}
	spriteType = {
		name = "GFX_CPG_jmo_with_british"
		texturefile = "gfx/interface/ideas/CPG/CPG_jmo_with_british.dds"
	}
	spriteType = {
