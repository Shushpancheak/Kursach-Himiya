	}
	spriteType = {
		name = "GFX_CPG_poor_infrastructure"
		texturefile = "gfx/interface/ideas/CPG/CPG_poor_infrastructure.dds"
	}
	spriteType = {
		name = "GFX_CPG_presledyvanie_bolsh"
		texturefile = "gfx/interface/ideas/CPG/CPG_presledyvanie_bolsh.dds"
	}
	spriteType = {
