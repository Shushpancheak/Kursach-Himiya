# RoR fork — isolated environment (plan C10).
# Applied by direnv on directory entry, so it cannot be defeated by forgetting
# an alias or opening a different terminal. Run `direnv allow` once.

# --- Claude Code isolation -------------------------------------------------
# Verified against the shipped binary (2.1.220): the variable is CLAUDE_CONFIG_DIR.
# A separate config dir means the owner's work-scope config, skills and MCP
# servers are absent from every session started in this repo. Spike S6: RESOLVED.
export CLAUDE_CONFIG_DIR="$HOME/.claude-ror"

# --- Telemetry off ---------------------------------------------------------
export OPENSPEC_TELEMETRY=0
export DO_NOT_TRACK=1

# --- Reference material (deliberately outside the repo) --------------------
# The Paradox wiki snapshot ships in a kit with no licence file, and vanilla
# game files are Paradox's. Neither belongs in a public fork. They live in a
# sibling tree and are reached through these variables on both machines.
export ROR_REFS="${ROR_REFS:-$HOME/ror-refs}"
export HOI4_VANILLA_ROOT="${HOI4_VANILLA_ROOT:-$ROR_REFS/hoi4-vanilla}"
export PARADOX_WIKI="${PARADOX_WIKI:-$ROR_REFS/paradox_wiki}"
export HOI4SKILL="${HOI4SKILL:-$ROR_REFS/hoi4skill/bin/hoi4skill}"

# --- Repo tooling ----------------------------------------------------------
export ROR_ROOT="$PWD"
PATH_add tools/bin
