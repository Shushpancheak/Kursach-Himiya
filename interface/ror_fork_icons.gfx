		texturefile = "gfx/interface/ideas/idea_red_new_army.dds"
	}
	# --- misspelled references to sprites that exist in vanilla -------------
	# These four ideas name a vanilla sprite with the wrong case or a small
	# spelling slip. Declaring an alias fixes the icon without editing an
	# upstream file, and is harmless if the engine's lookup turns out to be
	# case-insensitive. The texturefile paths resolve against the game root.
	spriteType = {
		name = "GFX_idea_mex_callistas"                    # MEX_callistas
		texturefile = "gfx/interface/ideas/idea_mex_callistas.dds"
	}
	spriteType = {
		name = "GFX_idea_generic_oppresion"                # generic_oppression
		texturefile = "gfx/interface/ideas/idea_generic_oppression.dds"
	}
	spriteType = {
		name = "GFX_idea_idea_generic_war_preparation"     # doubled idea_ prefix
		texturefile = "gfx/interface/ideas/idea_generic_war_preparation.dds"
	}
	spriteType = {
		name = "GFX_idea_yug_orthodox_church_support"      # YUG_orthodox_church_support
